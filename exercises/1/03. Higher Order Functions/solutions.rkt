#lang racket

; Някои функции за удобство
(define (1+ x) (+ x 1))
(define (neg x) (- x))
(define (id x) x)
(define (const x) (λ (y) x))
(define (const* x) (λ (y) y))
(define (even x) (= (remainder x 2) 0))
(define (odd x) (not (even x)))

; 01. Да се дефинира функция, която приема функция и някакъв аргумент
; и връща резултата от двукратното прилагане на функцията.

; Пример: (apply-twice 1+ 2) ~> 4
(define (apply-twice f x) (f (f x)))

; 02. Да се дефинира функция, която приема естествено число n,
; функция и някакъв аргумент и връща резултата от n-кратното
; прилагане на функцията.

; Пример: (apply-n 4 1+ 2) ~> 6
(define (apply-n n f x)
  (if (zero? n)
      x
      (f (apply-n (- n 1) f x))))

; 03. Да се дефинира функция, която приема естествено число n
; и функция и връща n-кратното прилагане на функцията.
; С какво се различава тази функция от горната?

(define (apply-n* n f)
  (if (zero? n)
      id
      (lambda (x) (f ((apply-n* (- n 1) f) x)))))

; 04. Да се дефинира функция, която приема две функции и връща
; тяхната композиция.

(define (compose f g)
  (lambda (x) (f (g x))))

; 05. Да се дефинира функция, която приема двуместна функция
; и обръща реда на аргументите, върху които се прилага функцията.

; Пример: ((flip -) 1 2) ~> 1
(define (flip f)
  (lambda (y x) (f x y)))

; 06. Да се дефинира функция, която приема двуместна функция f
; и връща последователност от две едноместни функции,
; като крайният резултат е самото прилагане на f върху аргументите.

; Пример: (((curry-2 +) 1) 2) ~> 3
(define (curry-2 f)
  (lambda (x)
    (lambda (y)
      (f x y))))

; Бонус: Да се дефинира функция, аналогична на горната,
; но да работи за n-местни функции, където n е произволно.

(define (curry-n n f)
  (define (go n f args)
    (if (zero? n)
        (apply f (reverse args))
        (lambda (x) (go (- n 1) f (cons x args)))))
  (go n f '()))

; 07. Да се дефинира функцията accumulate, показвана на лекции.
(define (accumulate op nv a b term next)
  (if (> a b)
      nv
      (op (term a) (accumulate op nv (next a) b term next))))

; Следващите задачи да се решат, използвайки accumulate.

; 08. Да се дефинира функция, която намира сумата на числата в
; някакъв интервал [a;b] и някаква стъпка step.

; Пример: (sum-interval-with-step 0.5 1 2) ~> 4.5
; Обяснение: Числата, които попадат в сумата, са 1, 1.5 и 2.
(define (sum-interval-with-step step a b)
  (accumulate + 0 a b id (lambda (x) (+ x step))))

; 09. Да се дефинира функция, която повдига някакво число x
; на степен n.

; Пример: (pow 2 5) ~> 32
(define (pow base exp)
  (accumulate * 1 1 exp (const base) 1+))

; 10. Да се дефинира функция, която намира броя на всички
; естествени делители на естествено число.

; Пример: (count-divisors 12) ~> 6
; Обяснение: 12 се дели на 1, 2, 3, 4, 6, 12.
(define (divides n k)
  (= (remainder k n) 0))

(define (count-divisors n)
  (accumulate + 0 1 n (lambda (x)
                        (if (divides x n)
                            1
                            0))
              1+))

; 11. Да се дефинира функция, която приема предикат и проверява
; дали съществува x в интервала [a;b], за което p(x) е истина.

; Пример: (exists? even? 1 3) ~> #t
; Обяснение: 2 е в интервала [1;3] и е четно.
(define (exists? p? a b)
  (accumulate (lambda (b1 b2) (or b1 b2)) #f a b (lambda (x) (p? x)) 1+))

; 12. Да се дефинира функция, която връща n-кратната композиция на функция.

; Пример: ((compose-n 5 1+) 0) ~> 5
(define (compose-n n f)
  (accumulate compose id 1 n (const f) 1+))

; 13. Да се дефинира функция, която намира броя неподвижни точки на функция
; f в интервала (a;b). Една точка x е неподвижна за функцията f, ако
; f(x) = x.

; Пример: (fixpoints id 1 10) ~> 10
; Обяснение: id(x) = x за всяко x.
(define (fixpoints f a b)
  (accumulate + 0 a b (lambda (x)
                        (if (= x (f x))
                            1
                            0))
              1+))

; 14. Да се дефинира функция, която проверява дали число е просто.

; Пример: (prime? 5) ~> #t
(define (prime? x)
  (and (>= x 2) (accumulate (lambda (b1 b2) (and b1 b2))
                            #t
                            2
                            (- x 1)
                            (lambda (k)
                              (not (divides k x)))
                            1+)))

; 15. Да се дефинира функция, която намира такова x в интервал
; от цели числа [a;b], че функционалната стойност f(x) е най-голяма.

; Пример: (argmax neg -3 1) ~> -3
; Обяснение: -(-3) = 3 и функцията достига най-голямата си стойност в -3.
(define (argmax f a b)
  ; така създаваме нуламестна функция.
  ; това е удобно, защото ще оценим
  ; тялото ѝ само ако a <= b
  (define (result) (accumulate (lambda (x y)
                (if (> (f x) (f y))
                    x
                    y))
              a
              a
              b
              id
              1+))
  (or (and (<= a b) (result)) -inf.0))

