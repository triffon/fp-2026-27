#lang racket

; За разлика от C++, където сме работили с масиви,
; в Scheme няма да използваме тях, а ще използваме
; т.нар. списъци. За разлика от масивите, техните
; елементи не са последователни в паметта, тъй
; като се имплементират чрез линейни едносвързани списъци.
; Това означава, че операции като индексиране са скъпи
; (тъй като има линейна сложност, при масиви е с константна такава).
; Но от друга страна, самата дефиниция на свързаните списъци
; е рекурсивна (припомнете си ги от курса по ООП), което
; ни позволява да правим структурна рекурсия по тези списъци,
; вместо да използваме индекси.

; Всеки списък в Scheme се представя като наредена двойка
; от глава (елемент) и опашка (друг списък), които се взимат
; съответно използвайки функциите car и cdr:

(define lst '(1 2 3))
(car lst) ; ~> 1
(cdr lst) ; ~> (2 3)
(car (cdr lst)) ; ~> 2
(car (cdr (cdr lst))) ; ~> 3

; За последните две имаме и съкратен синтаксис:

(cadr lst)
(caddr lst)

; Като цяло, между c и r можем да имаме между 1 и 4
; букви, всяка от които е a или d. Може допълнително
; да разгледате какво правят различните комбинации.

; Тогава, за да построим списък, реално просто бихме
; могли да построим поредица от наредени двойки,
; използвайки функцията cons, която приема елемент
; и списък и връща нов списък, където елементът
; е сложен в началото на списъка:

(cons 1 '(2 3)) ; ~> (1 2 3)
(cons 1 (cons 2 (cons 3 '()))) ; ~> (1 2 3)

; Всеки "правилен" (proper) списък завършва с празния списък.
; Възможно е и да не завършва с празния такъв, но това прави
; рекурсията върху списъци по-сложна. Такива списъци се наричат
; "неправилни" (improper или dotted pairs) и изглеждат така:

(cons 1 (cons 2 3)) ; ~> (1 . (2 . 3))

; Предикатите pair? и list? съответно ни позволяват
; да проверяваме дали нещо е наредена двойка и дали
; е правилен списък:

(define proper-list '(1 2 3))
(define improper-list (cons 1 (cons 2 3)))

(pair? proper-list)   ; ~> #t
(pair? improper-list) ; ~> #t

(list? proper-list)   ; ~> #t
(list? improper-list) ; ~> #f

; Възползвайки се от рекурсивната структура на списъците,
; можем да правим структурна рекурсия по следния начин:

(define (sum-elements lst)
  (if (null? lst)
      0
      (+ (car lst) (sum-elements (cdr lst)))))

(sum-elements '(1 2 3))

; В горните примери видяхме как се дефинира списък,
; използвайки апостроф (shorthand за функцията quote).
; В случая quote (или ') е важен, тъй като, ако просто
; напишем (1 2 3), това би се третирало като комбинация,
; т.е. ще даде грешка, защото 1 не е функция. quote
; ни позволява да третираме някакъв израз като данни
; (може да си го мислите като някакъв низ, т.е.
; изразът НЕ се оценява), вместо да го оценяваме.
; Затова, ако напишем следното, ще имаме проблем:

(sum-elements '(1 (+ 1 2)))
(sum-elements (quote (1 (+ 1 2))))

; защото quote ще ни върне БУКВАЛНО (1 (+ 1 2)),
; т.е. изобщо няма да оцени (+ 1 2).

; Затова, ако искаме всички изрази в списък да
; се оценят, можем да използваме функцията list:

(sum-elements (list 1 (+ 1 2)))

; Забележете, че list е вариадична функция
; и приема неопределен брой аргументи, всеки
; от който е елемент на списъка.
