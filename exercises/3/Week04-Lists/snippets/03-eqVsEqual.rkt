#lang racket

; Форми на равенство:
;  - (eq? x y) - #t, когато x и y заемат едно и също място в паметта
;    (т.е. са един и същ обект);
;  - (equal? x y) - сравнява по съдържание: еднакви атоми или наредени двойки
;    (и следователно списъци), чиито компоненти са равни в смисъла на equal?.
; Ако (eq? x y), то със сигурност (equal? x y).

(define a 3)
(define b 3)
(define c a)

; Малките цели числа не се заделят в паметта като отделни обекти,
; затова eq? връща #t за тях - но на това не бива да се разчита.
(eq? a b) ; #t
(eq? a c) ; #t

(define d '(1 . 2))
(define e '(1 . 2))
(define f d)

; d и e са две различни наредени двойки с еднакво съдържание,
; а f е просто друго име за същата двойка като d.
(eq? d e) ; #f
(eq? d f) ; #t

(equal? d e) ; #t - сравнява компонентите им една по една

; Някои вградени процедури имат варианти с различно сравнение на елементите:
; remq сравнява с eq?, а remove - с equal?.
; Затова за списъци и двойки почти винаги искаме вариантите с equal?.
(remq '(1 . 2) '((1 . 2) (4 . 5)))   ; сравнява с eq? - нищо не се премахва
(remove '(1 . 2) '((1 . 2) (4 . 5))) ; сравнява с equal? - '((4 . 5))
; Вариантите със * премахват всички срещания на всеки от елементите в първия списък.
(remq* (list (cons 1 2) (cons 4 5)) '((1 . 2) (4 . 5) (1 . 2)))   ; сравнява с eq? - нищо не се премахва
(remove* (list (cons 1 2) (cons 4 5)) '((1 . 2) (4 . 5) (1 . 2))) ; сравнява с equal? - '()
