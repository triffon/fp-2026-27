#lang racket

; Асоциативен списък: списък от двойки (ключ . стойност).
(list '(1 . "One") '(2 . "Two") '(3 . "Three"))

; (assoc key alist) връща първата двойка с такъв ключ (цялата двойка, не само
; стойността) или #f, ако няма такава. Сравнява ключовете с equal?.
(assoc 1 '((1 . "One") (2 . "Two") (3 . "Three") (1 . "Four"))) ; '(1 . "One")
(assoc 4 '((1 . "One") (2 . "Two") (3 . "Three") (1 . "Four"))) ; #f

(define alist '((1 . "One") (2 . "Two") (3 . "Three")))

; Ключовете и стойностите поотделно - map с car / cdr върху двойките.
(map car alist) ; '(1 2 3)
(map cdr alist) ; '("One" "Two" "Three")

; Премахване на двойка: remove маха първото срещане на елемент (сравнява с equal?),
; а самата двойка за даден ключ намираме с assoc.
(remove (assoc 2 alist) alist) ; '((1 . "One") (3 . "Three"))
(remove (assoc 7 alist) alist) ; непроменен - assoc връща #f, който не е елемент на списъка

; Асоциативният списък е неизменим - "добавяме" или "променяме", като строим нов списък
; с новата двойка отпред. assoc намира първото срещане, така че новата двойка "засенчва" старата.
(assoc 2 (cons '(2 . "Dva") alist)) ; '(2 . "Dva")

; append-map: map, чиито резултати са списъци, слепени в един - същото като (apply append (map f xs)).
(map (λ (x) (list x x)) '(1 2 3))        ; '((1 1) (2 2) (3 3))
(append-map (λ (x) (list x x)) '(1 2 3)) ; '(1 1 2 2 3 3)
